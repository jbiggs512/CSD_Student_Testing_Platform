DATABASE_URL=sqlite:///./dev.db
# Optional: set a persistent 32+ byte secret key for JWT signing across restarts
# SECRET_KEY=replace_with_a_secure_random_32_byte_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Azure Communication Services Email
# AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
# AZURE_COMMUNICATION_SENDER_EMAIL=DoNotReply@<domain>.azurecomm.net
EMAIL_ENABLED=true
EMAIL_TIMEOUT_SECONDS=30
